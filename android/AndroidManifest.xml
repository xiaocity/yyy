<?xml version="1.0" encoding="utf-8"?>
<!-- 没有 INTERNET 权限：这个游戏完全离线，装完不联网也能玩 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cityg.caoyuan"
    android:versionCode="117"
    android:versionName="1.0.0">

  <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36" />

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher"
      android:theme="@android:style/Theme.Material.Light.NoActionBar"
      android:hardwareAccelerated="true"
      android:allowBackup="true">

    <!-- targetSdk 36 起，Android 16 会在 >=600dp 的屏幕上无视 screenOrientation 与
         resizeableActivity，把竖屏锁定的应用照样摆成横屏。这个游戏的版式是按竖屏
         设计的，横过来会散，所以先声明退出。
         注意：这只是过渡手段，官方说明该开关到 API 37 就失效，真正的解法是做横屏
         适配。上架前请在大屏设备/模拟器上确认它确实生效。 -->
    <property
        android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
        android:value="true" />

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:screenOrientation="portrait"
        android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
