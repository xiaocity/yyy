<?xml version="1.0" encoding="utf-8"?>
<!-- 没有 INTERNET 权限：这个游戏完全离线，装完不联网也能玩 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cityg.caoyuan"
    android:versionCode="119"
    android:versionName="1.0.0">

  <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36" />

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher"
      android:theme="@android:style/Theme.Material.Light.NoActionBar"
      android:hardwareAccelerated="true"
      android:allowBackup="true">

    <!-- 大屏不再声明退出 resizability。
         这条开关（PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY）原本用来挡住
         Android 16 在 >=600dp 屏幕上无视 screenOrientation 的行为，理由写的是
         「版式按竖屏设计，横过来会散」。那个判断在把平板版式改成 560dp 居中栏
         （见 71da743）之前成立，之后就不成立了。

         在 1600x2560 @320dpi（= 800x1280 dp）的平板模拟器上，两种清单各装一遍实测：
           留着开关 —— 横屏下应用不旋转，被塞进竖屏兼容窗口，两侧大片黑边，系统
                        还弹出「See and do more / 双击应用外部可重新摆放」这个
                        「此应用未适配大屏」的提示框。
           去掉开关 —— 横屏铺满，560dp 栏居中，首页与对局页版式都完整，
                        无黑边也无提示框。对局页最吃高度，已一并确认。
         网页版同样在 1280x800 / 1024x768 / 960x600 / 800x600 下都不溢出 ——
         页面本来就有 @media (max-height:700px) 的矮屏适配兜底。

         activity 上的 screenOrientation="portrait" 保留：手机（<600dp）仍锁竖屏，
         大屏上 Android 16 本来就会忽略它。 -->

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:screenOrientation="portrait"
        android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
